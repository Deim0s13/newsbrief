<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.newsbrief.portforwards</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_PATH__/scripts/port-forwards-watch.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <!-- Unlike com.newsbrief.infra (RunAtLoad-only), this job is meant to stay
         running: the script itself loops forever supervising each port-forward
         child. KeepAlive relaunches the *script* if it ever exits/crashes, which
         is a second layer of resilience on top of the script's own restart loop. -->
    <key>KeepAlive</key>
    <true/>

    <!-- Don't hammer restarts if something is fundamentally broken (e.g. kind down) -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>__PROJECT_PATH__/logs/port-forwards-watch-stdout.log</string>

    <key>StandardErrorPath</key>
    <string>__PROJECT_PATH__/logs/port-forwards-watch-stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
</dict>
</plist>
